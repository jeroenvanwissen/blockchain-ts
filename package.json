{
	"name": "blockchain-ts",
	"version": "0.0.1",
	"description": "A hybrid PoW/PoS blockchain node in TypeScript",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "tsx src/index.ts",
		"build": "tsc",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"check": "npm run build && npm test && npm run lint",
		"test": "jest",
		"smoke": "tsx src/smoke.ts",
		"e2e": "tsx src/e2e.ts",
		"cli": "tsx src/cli.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeroenvanwissen/blockchain-ts.git"
	},
	"author": "Jeroen van Wissen",
	"license": "CC0-1.0",
	"bugs": {
		"url": "https://github.com/jeroenvanwissen/blockchain-ts/issues"
	},
	"homepage": "https://github.com/jeroenvanwissen/blockchain-ts#readme",
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.6",
		"@types/secp256k1": "^4.0.6",
		"@types/ws": "^8.18.2",
		"@typescript-eslint/eslint-plugin": "^8.73.0",
		"@typescript-eslint/parser": "^8.73.0",
		"eslint": "^8.57.1",
		"eslint-plugin-jest": "^29.0.1",
		"jest": "^30.5.2",
		"ts-jest": "^29.4.15",
		"tsx": "^4.20.3",
		"typescript": "~6.0.3"
	},
	"dependencies": {
		"async-mutex": "^0.5.0",
		"protobufjs": "^8.0.0",
		"secp256k1": "^5.0.2",
		"ws": "^8.18.3"
	}
}
