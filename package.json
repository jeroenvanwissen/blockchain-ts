{
	"name": "blockchain-ts",
	"version": "0.0.1",
	"description": "A hybrid PoW/PoS blockchain node in TypeScript",
	"type": "module",
	"engines": {
		"node": "^22.13.0 || >=24"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"start": "tsx src/index.ts",
		"build": "tsc && node -e \"require('fs').cpSync('src/api/explorer', 'dist/api/explorer', { recursive: true })\"",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"check": "npm run build && npm test && npm run lint",
		"test": "jest",
		"smoke": "tsx src/smoke.ts",
		"e2e": "tsx src/e2e.ts",
		"cli": "tsx src/cli.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeroenvanwissen/blockchain-ts.git"
	},
	"author": "Jeroen van Wissen",
	"license": "CC0-1.0",
	"bugs": {
		"url": "https://github.com/jeroenvanwissen/blockchain-ts/issues"
	},
	"homepage": "https://github.com/jeroenvanwissen/blockchain-ts#readme",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.6",
		"@types/secp256k1": "^4.0.7",
		"@types/ws": "^8.18.2",
		"eslint": "^10.15.0",
		"eslint-plugin-jest": "^29.17.1",
		"globals": "^17.14.0",
		"jest": "^30.5.2",
		"ts-jest": "^29.4.15",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.74.0"
	},
	"dependencies": {
		"async-mutex": "^0.5.0",
		"protobufjs": "^8.0.0",
		"secp256k1": "^5.0.2",
		"ws": "^8.18.3"
	}
}
